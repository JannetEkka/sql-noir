{
  "name": "sql-noir",
  "version": "0.1.0",
  "description": "A SQL detective game: an agent sets cases on real data in Zetaris, checks every answer against the data, and explains why with evidence.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "record:schema": "tsx scripts/record-schema.ts",
    "conformance:hmem": "tsx vendor/meterless/hmem/conformance/runner.ts",
    "validate:cases": "tsx scripts/validate-cases.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
