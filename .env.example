# Copy this file to .env and fill in your own values. Never commit .env.

# Zetaris, running locally in Docker (see README).
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create under Management -> API Tokens in the Zetaris web UI.
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift: copy the URL and token from Nightshift's Console.
# The NVIDIA key stays in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
